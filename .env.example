PORT=3000
NODE_ENV=production

# Папка для сессии WhatsApp (на Render с диском: /data/sessions)
SESSION_PATH=./sessions

# Строка подключения Neon Postgres. Если задана — сессия хранится в базе (RemoteAuth),
# если пусто — в папке SESSION_PATH (LocalAuth).
DATABASE_URL=

# Путь к Chromium (в Docker/Render: /usr/bin/chromium). Локально можно оставить пустым.
PUPPETEER_EXECUTABLE_PATH=

# Привязка по коду вместо QR: номер аккаунта бота в международном формате, например 996555123456
PAIR_PHONE=
