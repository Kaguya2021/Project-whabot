# База данных PostgreSQL (например, Neon / Supabase / Render)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Номер телефона для привязки WhatsApp (без +)
PAIR_PHONE=996700000000

# Google Gemini API ключ (получить в https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (по умолчанию быстрая gemini-3.5-flash-lite; можно gemini-3.6-flash или gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash-lite

# Уровень размышления модели: minimal | low | medium | high | off (minimal — самый быстрый ответ в чате)
GEMINI_THINKING=minimal

# Кулдаун на ИИ на одного пользователя в мс (по умолчанию 4000 = 4 сек)
AI_COOLDOWN_MS=4000

# Отвечать ли ИИ при reply на сообщения самого бота (true / false)
AI_REPLY_TRIGGER=true

# Приветствовать ли новых участников в группе (true / false)
WELCOME_ENABLED=true

# JID группы для отправки отчётов посещаемости (из /api/send)
REPORT_GROUP_JID=

# Пароль для веб-страницы посещаемости (необязательно)
REPORT_PASSWORD=

# Список JID групп для автопоздравлений с ДР через запятую (необязательно)
GROUP_JIDS=

# Порт HTTP-сервера
PORT=3000
